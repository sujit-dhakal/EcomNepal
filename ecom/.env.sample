# Safe development defaults. Replace secrets and third-party credentials for
# anything other than local development.
POSTGRES_DB=ecom
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

SECRET_KEY=django-insecure-local-development-only

# Hostnames allowed to access Django and the API URL used by the browser.
# Use a comma-separated host list for ALLOWED_HOSTS and include the scheme in URLs.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=true
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CHATBOT_API_URL=http://127.0.0.1:8080
# Used for API requests made by the frontend server inside Docker.
API_INTERNAL_URL=http://django-app:8000

# Optional SMTP settings. The development default uses Django's console email
# backend, so registration and password-reset flows do not require SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional PayPal sandbox credentials.
CLIENT_ID=
CLIENT_SECRET=
NEXT_PUBLIC_CLIENT_ID=

# Optional chatbot credentials. The chatbot service still starts without this
# key, but /chat and document indexing require it.
OPENAI_API_KEY=
